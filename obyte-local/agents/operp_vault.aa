{
	// OPERP custody vault AA (operp-v2) — pure asset custody.
	//
	// Trust model: NO owner key. This AA holds the collateral (base) and the
	// PERP governance asset and pays ONLY proof-gated withdrawals against
	// the rollup AA (ROLLUP_AA_HERE) finalized assertion forest. It accepts
	// no assertions, has no lock/challenge/finalize path, and cannot be
	// upgraded — a later custody AA migrates funds through the same
	// finalized-root withdrawal path.
	//
	// WITHDRAWALS ARE PROOF-GATED against the rollup AA last finalized
	// 1024-hex aa_forest (16 shard merkle trees over hex strings; Oscript
	// sha256 hashes UTF-8 text):
	//   node = sha256(left_hex + right_hex) -> hex
	//   leaf = sha256(acct: + account_hex + : + collateral_decimal + : +
	//                 perp_decimal + : + withdrawn_decimal) -> hex
	// withdraw requires amount, withdrawn, leaf_account, collateral, perp,
	// shard, proof. shard = the account shard index 0..15; perp = proven
	// PERP balance (may be 0); withdrawn = leaf cumulative withdrawal total
	// W. The AA enforces amount + wd_<addr> <= min(collateral, withdrawn)
	// (amount non-negative; decimal strings capped at 15 chars); optional
	// perp_amount claims less than the full PERP remainder. proof = sibling
	// list within the shard tree (depth <= 16); the AA folds it, extracts
	// the claimed shard root via substring(shard*64, 64) and compares.
	// Empty shards commit a distinct sentinel root off-chain so zero-proofs
	// cannot hop shards. ROLLUP_AA_HERE is substituted at deploy/test time.
	// State vars: wd_<addr> (cumulative base withdrawn), wp_<addr>
	// (cumulative PERP withdrawn), pperp_<addr> (PERP deposits received).
	bounce_fees: { base: 10000 },
	messages: {
		cases: [
			{
				if: "{trigger.data.deposit}",
				init: "{
					if (trigger.output[[asset=base]] - 10000 <= 0)
						bounce('deposit too small');
				}",
				messages: [
					{
						app: "state",
						state: "{
						}"
					}
				]
			},
			{
				// PERP governance asset deposit: credits pperp_<address>,
				// the reconciliation mirror of the sidechain's GovDeposit
				// credits (keyed by aa_unit). Without this explicit case
				// ocore's auto-bounce would swallow the asset-bearing
				// payment; here it is accepted and ledgered instead.
				if: "{trigger.data.deposit_perp}",
				init: "{
					if (!(trigger.output[[asset='PERP_ASSET_ID_HERE']] > 0))
						bounce('bad deposit');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['pperp_' || trigger.address] = (var['pperp_' || trigger.address] otherwise 0) + trigger.output[[asset='PERP_ASSET_ID_HERE']];
						}"
					}
				]
			},
			{
				// PROOF-GATED withdrawal against the rollup AA's finalized
				// aa_forest. Balance authority = the proven leaf's collateral.
				if: "{trigger.data.withdraw}",
				init: "{
					$lf = var['ROLLUP_AA_HERE']['last_finalized'];
					$h = $lf;
					if (!$lf)
						bounce('not finalizable');
					// Presence gate: missing trigger fields evaluate to boolean
					// false, so typeof()==='boolean' detects absence while legal
					// falsy values ('0', 0) pass.
					if (typeof(trigger.data.amount) == 'boolean'
						OR typeof(trigger.data.amount) == 'string'
						OR typeof(trigger.data.withdrawn) == 'boolean'
						OR typeof(trigger.data.leaf_account) == 'boolean'
						OR typeof(trigger.data.collateral) == 'boolean'
						OR typeof(trigger.data.perp) == 'boolean'
						OR typeof(trigger.data.proof) == 'boolean')
						bounce('bad claim');
					// Shard tag: selects which of the 16 committed shard roots
					// this proof must fold to. The AA trusts the claimed shard:
					// a mis-claimed shard folds to that shard's root and fails
					// unless the leaf truly lives there.
					$shard = trigger.data.shard;
					if (typeof(trigger.data.shard) == 'boolean' OR $shard < 0 OR $shard > 15
						OR !is_integer($shard))
						bounce('bad shard');
					// Root source: the rollup's finalized forest.
					$src = var['ROLLUP_AA_HERE']['aa_forest_' || $h];
					// perp length cap must run BEFORE the subtraction below: a
					// malformed over-15-digit string would fatal in the
					// arithmetic instead of bouncing (same short-circuit issue
					// as the main amount gate, applied to the earlier statement).
					if (length(trigger.data.perp) > 15)
						bounce('bad claim amount');
					// Single gate for leaf ownership and the GLOBAL cumulative
					// caps wd_/wp_ (anti-replay across heights; every withdrawal
					// caps the claim; perp_amount optionally claims less).
					$unclaimed = trigger.data.perp - (var['wp_' || trigger.address] otherwise 0);
					// Optional partial PERP claim: default claims the FULL
					// unclaimed remainder; `perp_amount` (0 <= x < unclaimed)
					// claims less so a collateral-only withdrawal cannot be
					// forced to drain the proven PERP balance.
					$perp_claimed = (typeof(trigger.data.perp_amount) == 'number'
						AND trigger.data.perp_amount >= 0
						AND trigger.data.perp_amount < $unclaimed)
						? trigger.data.perp_amount : $unclaimed;
					// Length caps come FIRST: OR short-circuits, so a malformed
					// over-15-digit string must bounce here — reaching `min`
					// below with such input would fatal (not a decimal) instead
					// of bouncing, and the cap would never be evaluated.
					if (trigger.data.leaf_account != trigger.address
						OR length(trigger.data.collateral) > 15 OR length(trigger.data.perp) > 15 OR length(trigger.data.withdrawn) > 15
						OR trigger.data.amount < 0
						OR trigger.data.amount + (var['wd_' || trigger.address] otherwise 0) > min(trigger.data.collateral, trigger.data.withdrawn)
						OR $perp_claimed < 0)
						bounce('bad claim amount');
					$fold = ($acc, $i, $sib) => (!$acc OR !$sib.hash) ? false
						: sha256(($sib.right ? $acc || $sib.hash : $sib.hash || $acc), 'hex');
					$root = reduce(trigger.data.proof, 16, $fold,
						sha256('acct:' || trigger.data.leaf_account || ':' || trigger.data.collateral || ':' || trigger.data.perp || ':' || trigger.data.withdrawn, 'hex'));
					// Extract the claimed shard's root from the 1024-hex forest.
					if ($root != substring($src, $shard * 64, 64))
						bounce('bad merkle root');
				}",
				messages: [
					{
						// Pure-PERP withdrawal (amount=0) emits no base output —
						// Oscript forbids 0-amount outputs.
						if: "{trigger.data.amount > 0}",
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.address}",
									amount: "{trigger.data.amount}"
								}
							]
						}
					},
					{
						// Oscript forbids 0-amount outputs — emit the PERP
						// payment only when something is actually claimed.
						if: "{$perp_claimed > 0}",
						app: "payment",
						payload: {
							asset: "PERP_ASSET_ID_HERE",
							outputs: [
								{
									address: "{trigger.address}",
									amount: "{$perp_claimed}"
								}
							]
						}
					},
					{
						app: "state",
						state: "{
							var['wd_' || trigger.address] += trigger.data.amount;
							var['wp_' || trigger.address] += $perp_claimed;
						}"
					}
				]
			}
		]
	}
}
