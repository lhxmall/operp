{
	// OPERP MVP vault AA — security-hardened version.
	//
	// Trust model: NO owner key. Upgrading = deploy a new AA and migrate funds
	// through the same finalized-root withdrawal path. All protocol constants
	// below mirror Rust constants in crates/operp-types/src/lib.rs (Rust is the
	// single source of truth; Oscript cannot include them):
	//   'operp-mvp-1'  -> CHAIN_ID
	//   600           -> OBYTE_STABILITY_SECS (lock stability window)
	//   3600          -> CHALLENGE_SECS (challenge window before finalize)
	//   10000         -> BOUNCE_FEES base (deducted from trigger outputs)
	//   20000         -> challenge bond minimum incl. bounce fee headroom
	//
	// WITHDRAWALS ARE PROOF-GATED. The operator commits `aa_root` per batch:
	// a merkle tree over hex strings (Oscript sha256 hashes UTF-8 text):
	//   leaf = sha256("acct:" + account_hex + ":" + collateral_decimal_string) -> hex
	//   node = sha256(left_hex + right_hex) -> hex
	// (built by operp_state::aa_account_leaf / aa_parent / aa_root_of).
	// withdraw requires { height, amount, leaf_account, collateral, proof }
	// where proof = [ {hash, right}, ... ] sibling list; the AA recomputes the
	// root with string ops and compares to var['root_' || last_finalized].
	//
	// State vars:
	//   boot, chain_id, last_locked, last_finalized
	//   submitted_at_<h>, cand_root_<h>, cand_prev_<h>, cand_fills_<h>,
	//     cand_unit_<h>, cand_who_<h>            candidate (replaceable pre-lock)
	//   root_<h>, winner_<h>, stable_at_<h>      locked root
	//   frozen_<h>   absent/0 = ok, 1 = challenged, 2 = permanently failed
	//   challenger_<h>, bond_<address>           challenge bond accounting


	bounce_fees: { base: 10000 },
	messages: {
		cases: [
			{
				if: "{trigger.data.deposit}",
				init: "{
					$paid = trigger.output[[asset=base]] - 10000;
					if ($paid <= 0)
						bounce('deposit too small');
					$k = 'bal_' || trigger.address;
				}",
				messages: [
					{
						app: "state",
						state: "{
							if (!var['boot']){
								var['boot'] = 1;
								var['chain_id'] = 'operp-mvp-1';
								var['last_locked'] = 0;
								var['last_finalized'] = 0;
							}
							var['bal_' || trigger.address] = (var['bal_' || trigger.address] otherwise 0) + trigger.output[[asset=base]] - 10000;
						}"
					}
				]
			},
			{
				if: "{trigger.data.submit}",
				init: "{
					$h = trigger.data.height;
					if (trigger.data.chain_id != 'operp-mvp-1' OR !$h OR $h != var['last_locked'] + 1 OR !trigger.data.state_root OR !trigger.data.aa_root OR !trigger.data.fills_hash)
						bounce('bad submit');
					if (var['last_locked'] > 0 AND trigger.data.prev_state_hash != var['root_' || var['last_locked']])
						bounce('prev mismatch');
					if (var['root_' || $h])
						bounce('already locked');
					$loser_check = ($addr, $hh) => {
						$w = var['fee_winner_' || $hh];
						if (!$w)
							return false;
						if ($w == $addr)
							return false;
						return true;
					};
					$is_loser = $loser_check(trigger.address, trigger.data.height);
				}",
				messages: [
					{
						// Consolation for losing the race: refund everything
						// net of processing, plus a small bonus from the pot.
						// (Reads the PRE-trigger fee_winner; state message must
						// come last in Oscript.)
						if: "{$is_loser}",
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.address}",
									amount: 5000
								}
							]
						}
					},
					{
						app: "state",
						state: "{
							var['cand_root_' || trigger.data.height] = trigger.data.state_root;
							var['cand_aa_root_' || trigger.data.height] = trigger.data.aa_root;
							var['cand_prev_' || trigger.data.height] = trigger.data.prev_state_hash;
							var['cand_fills_' || trigger.data.height] = trigger.data.fills_hash;
							var['cand_unit_' || trigger.data.height] = trigger.unit;
							var['cand_who_' || trigger.data.height] = trigger.address;
							var['submitted_at_' || trigger.data.height] = timestamp;
							// Fee race: AAs are triggered in stability order, so
							// the FIRST processed submit for this height is the
							// first-STABLE submission and wins the batch reward.
							if (!var['fee_winner_' || trigger.data.height]){
								var['fee_winner_' || trigger.data.height] = trigger.address;
							}
						}"
					}
				]
			},
			{
				if: "{trigger.data.lock}",
				init: "{
					$h = trigger.data.height;
					// stability gate (OBYTE_STABILITY_SECS = 600): simulates the
					// Obyte finality window on devnet where none exists.
					if (!var['cand_root_' || $h] OR var['root_' || $h] OR $h != var['last_locked'] + 1 OR timestamp < var['submitted_at_' || $h] + 600)
						bounce('cannot lock yet');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['root_' || trigger.data.height] = var['cand_root_' || trigger.data.height];
							var['aa_root_' || trigger.data.height] = var['cand_aa_root_' || trigger.data.height];
							var['winner_' || trigger.data.height] = var['cand_unit_' || trigger.data.height];
							var['stable_at_' || trigger.data.height] = timestamp;
							var['last_locked'] = trigger.data.height;
						}"
					}
				]
			},
			{
				if: "{trigger.data.challenge}",
				init: "{
					$h = trigger.data.height;
					if (!$h OR $h > var['last_locked'])
						bounce('bad height');
					if (!var['root_' || $h])
						bounce('not locked');
					if (var['frozen_' || $h])
						bounce('already frozen or failed');
					if (timestamp >= var['stable_at_' || $h] + 3600)
						bounce('challenge window closed');
					if (trigger.output[[asset=base]] - 10000 < 10000)
						bounce('bond too small');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['frozen_' || trigger.data.height] = 1;
							var['challenger_' || trigger.data.height] = trigger.address;
							var['bond_' || trigger.address] = (var['bond_' || trigger.address] otherwise 0) + trigger.output[[asset=base]] - 10000;
						}"
					}
				]
			},
			{
				// Operator response to a challenge within the window: unfreezes.
				// MVP devnet resolution: the operator re-submits the identical
				// committed root (fraud-proof games beyond this are Phase 2 —
				// recorded here as an explicit boundary, not silently omitted).
				if: "{trigger.data.respond}",
				init: "{
					$h = trigger.data.height;
					// Identity gate: only the account that submitted (last
					// replaced) the candidate for this height may respond.
					if (!$h OR trigger.address != var['cand_who_' || $h])
						bounce('not operator');
					if (var['frozen_' || $h] != 1)
						bounce('nothing to respond to');
					if (timestamp >= var['stable_at_' || $h] + 3600)
						bounce('response window closed');
					if (trigger.data.root_confirmed != var['root_' || $h])
						bounce('root mismatch');
				}",
				messages: [
					{
						app: "state",
						state: "{
							// unfreeze; challenger bond is confiscated to the AA pot
							var['frozen_' || trigger.data.height] = 0;
							$challenger = var['challenger_' || trigger.data.height];
							if ($challenger AND var['bond_' || $challenger]){
								var['bond_' || $challenger] -= trigger.output[[asset=base]] - 10000;
							}
						}"
					}
				]
			},
			{
				// finalize timer, with the challenge-FAILURE sweep folded in:
				//   frozen==1 and window over (operator never responded)
				//     -> height fails: frozen=2 permanent, root cleared,
				//        last_locked rolls back to h-1, challenger bond refunded.
				//   clean window -> root becomes the withdrawal basis for h.
				if: "{trigger.data.finalize}",
				init: "{
					$h = trigger.data.height;
					if (!$h)
						bounce('no height');
					if ($h > var['last_locked'])
						bounce('not locked');
					$failed = (var['frozen_' || $h] == 1 AND timestamp >= var['stable_at_' || $h] + 3600);
					if (!$failed){
						if (!var['root_' || $h] OR var['frozen_' || $h] OR timestamp < var['stable_at_' || $h] + 3600 OR $h != var['last_finalized'] + 1)
							bounce('cannot finalize');
					}
				}",
				messages: [
					{
						app: "state",
						state: "{
							if ($failed){
								var['frozen_' || trigger.data.height] = 2;
								var['root_' || trigger.data.height] = 0;
								var['aa_root_' || trigger.data.height] = 0;
								var['last_locked'] = trigger.data.height - 1;
								$challenger = var['challenger_' || trigger.data.height];
								var['bond_' || $challenger] += trigger.output[[asset=base]] - 10000;
							}
						else {
								var['last_finalized'] = trigger.data.height;
								// Operator race reward: accrued claimable balance
								// for the first-stable submitter of this height.
								$fw = var['fee_winner_' || trigger.data.height];
								if ($fw){
									var['reward_' || $fw] += 20000;
								}
							}
						}"
					}
				]
			},
			{
				// PROOF-GATED withdrawal against the finalized aa_root.
				// balance authority = the proven leaf's collateral, NOT bal_ vars.
				// bal_ is a diagnostic shadow ledger only (credited on deposit,
				// debited here); it never gates withdrawals — AA native balance
				// mechanically gates the payment, and stale/rolled-back roots
				// are the root-chain + challenge game's job, not bal_'s.
				if: "{trigger.data.withdraw}",
				init: "{
					$h = var['last_finalized'];
					if (!$h OR var['frozen_' || $h] OR (trigger.data.height AND trigger.data.height != $h))
						bounce('not finalizable');
					$amt = trigger.data.amount;
					$leaf_account = trigger.data.leaf_account;
					$collateral = trigger.data.collateral;
					$proof = trigger.data.proof;
					if (!$amt OR $amt <= 0 OR !$leaf_account OR !$collateral OR !$proof OR length($proof) > 16)
						bounce('invalid claim');
					if ($leaf_account != trigger.address OR $amt > $collateral)
						bounce('bad claim amount');
					$fold = ($acc, $i, $sib) => {
						if (!$acc OR !$sib.hash)
							return false;
						if ($sib.right)
							return sha256($acc || $sib.hash, 'hex');
						else
							return sha256($sib.hash || $acc, 'hex');
					};
					$leaf_of = ($addr, $col) => sha256('acct:' || $addr || ':' || $col, 'hex');
					$root_of = ($leaf2, $proof2) => reduce($proof2, 8, $fold, $leaf2);
					$leaf = $leaf_of($leaf_account, $collateral);
					$root = $root_of($leaf, $proof);
					if (!$root)
						bounce('bad sibling');
					if ($root != var['aa_root_' || $h])
						bounce('bad merkle root');
				}",
				messages: [
					{
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.address}",
									amount: "{trigger.data.amount}"
								}
							]
						}
					},
					{
						app: "state",
						state: "{
							var['bal_' || trigger.address] -= trigger.data.amount;
						}"
					}
				]
			},
			{
				// Operator race reward claim: pays the accrued byte balance.
				// If the AA is temporarily short of funds the unit bounces and
				// the claim stays accrued — retry later, nothing is lost.
				if: "{trigger.data.claim_reward}",
				init: "{
					$owed = (var['reward_' || trigger.address] otherwise 0);
					if (!$owed OR $owed > trigger.output[[asset=base]] - 10000)
						bounce('nothing claimable');
				}",
				messages: [
					{
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.address}",
									amount: "{$owed}"
								}
							]
						}
					},
					{
						app: "state",
						state: "{
							var['reward_' || trigger.address] = 0;
						}"
					}
				]
			}
		]
	}
}
