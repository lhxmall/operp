{
	// OPERP rollup AA (operp-v2) — custody-free assertion log.
	//
	// Trust model: NO owner key. This AA stores one bonded assertion per
	// height and finalizes it after CHALLENGE_SECS unless a bound dispute AA
	// reports fraud via {verdict:'fraud'}. There is NO pay-to-kill challenge
	// path: {challenge:1} is not a case here and never freezes anything.
// Constants mirror Rust (crates/operp-types/src/lib.rs):
//   'operp-v2'      -> CHAIN_ID
//   1               -> ASSERTION_VERSION
//   3600            -> CHALLENGE_SECS (finalize clean window from submit)
//   604800          -> ESCAPE_STALL_SECS (escape hatch)
//   1000000000000   -> SUBMIT_BOND_NET (standing pool floor, not per-height lock)
//   1000000000000   -> POOL_MIN (== SUBMIT_BOND_NET)
//   50              -> POOL_MAX_INFLIGHT (last_submitted-last_finalized < 50)
//   500000000000    -> SUBMIT_BOND_SLASH_HALF (fraud slash to challenger)
//   20000           -> RACE_REWARD (first-submitter reward)
	// DA convention (social, enforced by watchers off-chain): the submit
	// trigger unit carries a temp_data message with the batch JSON
	// (trace/ops/fills arrays); da_unit_<h> pins that unit. The AA does NOT
	// inspect unit[trigger.unit].messages (fragile at eval time).
	// State vars:
	//   last_submitted, last_finalized, dispute_aa, dispute_fill_aa
	//   submitted_at_<h>, state_root_<h>, aa_forest_<h> (1024 hex),
	//   prev_<h>, wit_root_<h>, trace_root_<h>, units_root_<h>,
	//   units_set_root_<h>, ops_root_<h>, fills_root_<h>,
	//   unit_count_<h>, wit_count_<h>, fill_count_<h>, da_unit_<h>, active_bond_<h>,
	//   fee_winner_<h>, frozen_<h> (absent/0 live, 2 failed),
	//   inbox_upto_<h> (submit timestamp: forces older than this belong here)
	//   pool_<addr> (standing submit pool; submits need >= 1e12)
	//   sbond_<addr>, reward_<addr>, slash_reward_<addr>
	bounce_fees: { base: 10000 },
	messages: {
		cases: [
			{
				// #13 anti-hijack: only the two addresses hardcoded into this
				// definition may bind — first-come is irrelevant, nobody can
				// squat the verdict channel. The dispute AAs carry this rollup
				// address in their bind trigger data instead of their own
				// definition (mutual hardcoding would be a chash cycle).
				if: "{trigger.data.set_dispute}",
				init: "{
					if (trigger.address != 'DISPUTE_AA_HERE' OR var['dispute_aa'])
						bounce('not authorized');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['dispute_aa'] = trigger.address;
						}"
					}
				]
			},
			{
				if: "{trigger.data.set_dispute_fill}",
				init: "{
					if (trigger.address != 'DISPUTE_FILL_AA_HERE' OR var['dispute_fill_aa'])
						bounce('not authorized');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['dispute_fill_aa'] = trigger.address;
						}"
					}
				]
			},
			{
				// Force-include: pin a sidechain unit id (64 hex) with its
				// timestamp. Batches submitted later must include every id
				// forced before their submit (a missing one is P-omit fraud).
				if: "{trigger.data.force}",
				init: "{
					$id = trigger.data.unit_id;
					if (typeof($id) == 'boolean' OR length($id) != 64)
						bounce('bad unit_id');
					if (var['inbox_' || $id])
						bounce('already forced');
					if (trigger.output[[asset=base]] < 10000)
						bounce('need fee');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['inbox_' || trigger.data.unit_id] = timestamp;
						}"
					}
				]
			},
			{
				// Standing pool fund: net inbound (minus bounce fee) credits
				// var['pool_'||trigger.address]. Submits gate on pool >= 1e12.
				if: "{trigger.data.pool}",
				init: "{
					if (trigger.output[[asset=base]] <= 10000)
						bounce('need pool');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['pool_' || trigger.address] = (var['pool_' || trigger.address] otherwise 0) + trigger.output[[asset=base]] - 10000;
						}"
					}
				]
			},
			{
				if: "{trigger.data.submit}",
				init: "{
					$h = trigger.data.height;
					$ls = (var['last_submitted'] otherwise 0);
					$lf = (var['last_finalized'] otherwise 0);
					// #37-7/37-8: a fraud-failed height (frozen==2) may be
					// RE-SUBMITTED in place — verdict now KEEPS
					// last_submitted pinned at the failed top, so both the
					// failed top itself (h == ls) and a lower stale height
					// (h < ls, blocked by frozen_6 in the adjacent-fraud
					// case) are re-opened through this branch.
					$frozen_h = (var['frozen_' || $h] otherwise 0);
					if (trigger.data.chain_id != 'operp-v2'
						OR !$h OR ($h != $ls + 1 AND $frozen_h != 2)
						OR trigger.data.assertion_version != 1
						OR !trigger.data.state_root OR length(trigger.data.state_root) != 64
						OR !trigger.data.prev_state_hash OR length(trigger.data.prev_state_hash) != 64
						// #37-4: the 1024-hex forest is bound to one 64-hex
						// forest hash at SUBMIT time (sha256 over its
						// concatenation, same domain as Rust's
						// aa_forest_hash). Length-checking aa_root alone
						// would let a poster store a bogus pair that no
						// honest chain can restate — freezing finalize at
						// that height; the fold check bounces it here where
						// the height is still claimable by the honest chain.
						OR !trigger.data.aa_root OR length(trigger.data.aa_root) != 64
						OR !trigger.data.aa_forest OR length(trigger.data.aa_forest) != 1024
						OR sha256(trigger.data.aa_forest, 'hex') != trigger.data.aa_root
						OR !trigger.data.wit_root OR length(trigger.data.wit_root) != 44
						OR !trigger.data.trace_root OR length(trigger.data.trace_root) != 44
						OR !trigger.data.units_root OR length(trigger.data.units_root) != 44
						OR !trigger.data.units_set_root OR length(trigger.data.units_set_root) != 44
						OR !trigger.data.ops_root OR length(trigger.data.ops_root) != 44
						OR !trigger.data.fills_root OR length(trigger.data.fills_root) != 44
						OR !is_integer(trigger.data.unit_count) OR trigger.data.unit_count < 1 OR trigger.data.unit_count > 200000
						OR !is_integer(trigger.data.wit_count) OR trigger.data.wit_count < 1
						OR !is_integer(trigger.data.fill_count) OR trigger.data.fill_count < 0)
					bounce('bad submit');
					// #37-8: a resubmit MUST bind to the actual pre-root of
					// its height (prev == state_root_<h-1>) — never to the
					// old cleared top/root pair. If the predecessor is also
					// fraud-failed (state_root zeroed) the bind fails
					// closed: fix the lower height first.
					if ($frozen_h == 2){
						if ($h > 1 AND trigger.data.prev_state_hash != (var['state_root_' || ($h - 1)] otherwise 0))
							bounce('prev mismatch');
					} else {
						// Fresh forward submit at ls+1: reject while the
						// predecessor is fraud-failed (its root is gone —
						// old code exempted this check, letting a submit
						// chain build on a failed height). Heights above a
						// failed top must resubmit via the frozen branch.
						if ($ls > 0 AND (var['frozen_' || $ls] otherwise 0) == 2)
							bounce('prev mismatch');
						if ($ls > 0 AND trigger.data.prev_state_hash != var['state_root_' || $ls])
							bounce('prev mismatch');
					}
					if (trigger.output[[asset=base]] < 10000)
						bounce('need fee');
					if ((var['pool_' || trigger.address] otherwise 0) < 1000000000000)
						bounce('need pool');
					if ($ls - $lf >= 50)
						bounce('pool occupancy');
					if (var['active_bond_' || $h] AND $h <= $ls AND $frozen_h != 2)
						bounce('height taken');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['submitted_at_' || trigger.data.height] = timestamp;
							var['state_root_' || trigger.data.height] = trigger.data.state_root;
							// #37-4: same-height twin binding — the forest hash
							// rides every submit alongside its 1024-hex expansion.
							var['aa_root_' || trigger.data.height] = trigger.data.aa_root;
							var['aa_forest_' || trigger.data.height] = trigger.data.aa_forest;
							var['prev_' || trigger.data.height] = trigger.data.prev_state_hash;
							var['wit_root_' || trigger.data.height] = trigger.data.wit_root;
							var['trace_root_' || trigger.data.height] = trigger.data.trace_root;
							var['units_root_' || trigger.data.height] = trigger.data.units_root;
							var['units_set_root_' || trigger.data.height] = trigger.data.units_set_root;
							var['ops_root_' || trigger.data.height] = trigger.data.ops_root;
							var['fills_root_' || trigger.data.height] = trigger.data.fills_root;
							var['unit_count_' || trigger.data.height] = trigger.data.unit_count;
							var['wit_count_' || trigger.data.height] = trigger.data.wit_count;
							var['fill_count_' || trigger.data.height] = trigger.data.fill_count;
							var['da_unit_' || trigger.data.height] = trigger.unit || '';
							var['inbox_upto_' || trigger.data.height] = timestamp;
							var['active_bond_' || trigger.data.height] = trigger.address;
							var['frozen_' || trigger.data.height] = 0;
							var['last_submitted'] = trigger.data.height;
							if (!var['fee_winner_' || trigger.data.height]){
								var['fee_winner_' || trigger.data.height] = trigger.address;
							}
						}"
					}
				]
			},
			{
				if: "{trigger.data.finalize OR trigger.data.escape_finalize}",
				init: "{
					$h = trigger.data.height;
					if (!$h)
						bounce('no height');
					if ($h > (var['last_submitted'] otherwise 0) OR !var['state_root_' || $h])
						bounce('not submitted');
					if (var['frozen_' || $h])
						bounce('challenged');
					// #37-7: heights submitted ABOVE a later-failed height
					// keep stale roots (no loop clearing); their prev_<h>
					// no longer equals the (resubmitted or zeroed)
					// state_root_<h-1>, so require the chain binding to
					// hold at finalize — else a stale h+1 could finalize on
					// a superseded state and pay the vault from a forest
					// the honest chain never committed.
					if ($h > 1 AND var['prev_' || $h] != (var['state_root_' || ($h - 1)] otherwise 0))
						bounce('stale height');
					$lf = (var['last_finalized'] otherwise 0);
					$sa = (var['submitted_at_' || $h] otherwise 0);
					if (timestamp < $sa + (trigger.data.escape_finalize ? 604800 : 3600)
						OR $h != $lf + 1)
						bounce('cannot finalize');
				}",
				messages: [
					{
						// #37-4: on-chain binding of the finalized forest to
						// the submit-committed hash. submit() already stored
						// aa_root_<h> alongside the 1024-hex expansion; the
						// operator cannot present a different corpus at
						// finalize/vault time. sha256(x,'hex') hashes the
						// UTF-8 forest string — same domain as Rust's
						// aa_forest_hash over the concatenated shard roots.
						app: "state",
						state: "{
							$forest = var['aa_forest_' || trigger.data.height];
							$root = var['aa_root_' || trigger.data.height];
							if (sha256($forest, 'hex') != $root)
								bounce('forest hash mismatch');
							var['last_finalized'] = trigger.data.height;
							$fw = var['fee_winner_' || trigger.data.height];
							if ($fw){
								var['reward_' || $fw] += 20000;
							}
						}"
					}
				]
			},
			{
				// Fraud verdict from a bound dispute AA: fail the height,
				// slash up to half the submit bond from the operator's
				// standing pool (capped at the pool's actual balance),
				// reopen h.
				if: "{trigger.data.verdict}",
				init: "{
					$da = (var['dispute_aa'] otherwise 0);
					$df = (var['dispute_fill_aa'] otherwise 0);
					if (trigger.address != $da AND trigger.address != $df)
						bounce('not dispute');
					if (trigger.data.verdict != 'fraud')
						bounce('bad verdict');
					$h = trigger.data.height;
					$ch = trigger.data.challenger;
					if (!$h OR !var['state_root_' || $h] OR var['frozen_' || $h]
						OR timestamp >= (var['submitted_at_' || $h] otherwise 0) + 3600)
						bounce('challenge not possible');
					if (typeof($ch) == 'boolean' OR length($ch) != 32 OR !is_valid_address($ch))
						bounce('bad challenger');
				}",
				messages: [
					{
						app: "state",
						state: "{
							var['frozen_' || trigger.data.height] = 2;
							var['state_root_' || trigger.data.height] = 0;
							var['aa_forest_' || trigger.data.height] = 0;
							var['aa_root_' || trigger.data.height] = 0;
							$op = var['active_bond_' || trigger.data.height];
							if ($op AND (var['pool_' || $op] otherwise 0) > 0){
								// #37-6: the shield debt can never exceed the
								// actually-seized amount — reward += pool
								// rounded to 0 when the standing pool is
								// drained (present constant lied about its
								// deposits and left shortfalls to the other
								// operators' shared pool).
								$p = (var['pool_' || $op] otherwise 0);
								$slashed = $p > 500000000000 ? 500000000000 : $p;
								var['pool_' || $op] = $p - $slashed;
								var['slash_reward_' || trigger.data.challenger] = (var['slash_reward_' || trigger.data.challenger] otherwise 0) + $slashed;
							}
							var['active_bond_' || trigger.data.height] = 0;
							var['fee_winner_' || trigger.data.height] = 0;
							// #37-7: last_submitted STAYS at the failed height
							// (frozen_<h>=2 means "failed, awaiting resubmit").
							// Rolling back to h-1 let the operator drain the
							// pool backing the still-live higher heights via
							// {claim:'pool'} the moment ls==lf again.
							var['last_submitted'] = trigger.data.height;
						}"
					}
				]
			},
			{
				if: "{trigger.data.claim}",
				init: "{
					$k = trigger.data.claim;
					if ($k != 'reward' AND $k != 'sbond' AND $k != 'slash' AND $k != 'pool')
						bounce('bad claim kind');
					if ($k == 'pool' AND (var['last_submitted'] otherwise 0) != (var['last_finalized'] otherwise 0))
						bounce('pool busy');
					// #37-7: a failed height keeps last_submitted pinned at
					// itself, so the busy gate alone again reads idle even
					// while that height still owes a correct re-submit —
					// block the drain while the highest submitted height is
					// fraud-failed (frozen==2). Heights j < h were finalized
					// before h (finalize is strictly sequential) and > h
					// cannot exist beyond the pinned top.
					if ($k == 'pool' AND (var['frozen_' || (var['last_submitted'] otherwise 0)] otherwise 0) == 2)
						bounce('pool busy');
					$key = ($k == 'reward' ? 'reward_' : ($k == 'sbond' ? 'sbond_' : ($k == 'slash' ? 'slash_reward_' : 'pool_')));
					$owed = (var[$key || trigger.address] otherwise 0);
					if (!$owed OR trigger.output[[asset=base]] < 10000)
						bounce('nothing claimable');
				}",
				messages: [
					{
						app: "payment",
						payload: {
							asset: "base",
							outputs: [
								{
									address: "{trigger.address}",
									amount: "{$owed}"
								}
							]
						}
					},
					{
						app: "state",
						state: "{
							var[$key || trigger.address] = 0;
						}"
					}
				]
			}
		]
	}
}
